rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReportOwnerOnCreate() {
      return isSignedIn()
        && (request.resource.data.userId == request.auth.uid
            || request.resource.data.reporterUid == request.auth.uid);
    }

    function isReportOwnerOnWrite() {
      return isSignedIn()
        && (resource.data.userId == request.auth.uid
            || resource.data.reporterUid == request.auth.uid);
    }

    match /users/{userId} {
      allow read, create, update: if ownsUserDoc(userId);
    }

    match /lostReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isReportOwnerOnCreate();
      allow update, delete: if isReportOwnerOnWrite();
    }

    match /foundReports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isReportOwnerOnCreate();
      allow update, delete: if isReportOwnerOnWrite();
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isReportOwnerOnCreate();
      allow update, delete: if isReportOwnerOnWrite();
    }

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn()
        && (request.resource.data.fromUid == request.auth.uid
            || request.resource.data.fromUid == 'system');
    }

    match /contactRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
    }
  }
}
